---
/**
 * Landing page for alfred.luminik.io.
 *
 * Routing decision (binding):
 * The previous landing was a Starlight `splash` template rendered from
 * src/content/docs/index.mdx (slug=""), which owned the root URL.
 *
 * To swap in a fully bespoke marketing landing without breaking the rest of
 * the Starlight docs (which still serve /concepts/, /guides/, /reference/,
 * /about/, /getting-started/), we rename that file to
 * `src/content/docs/docs.mdx` and update the sidebar entry in
 * astro.config.mjs (`slug: ""` → `slug: "docs"`).
 *
 * Astro then serves `src/pages/index.astro` at `/`, and Starlight serves the
 * docs hub at `/docs/`. Every other Starlight URL is unchanged.
 */

import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/marketing/Hero.astro";
import SectionHeader from "../components/marketing/SectionHeader.astro";
import JobCard from "../components/marketing/JobCard.astro";
import CodeBlock from "../components/marketing/CodeBlock.astro";
import FiringLifecycle from "../components/marketing/FiringLifecycle.astro";
import FleetStatus from "../components/marketing/FleetStatus.astro";
import SpecsDrivenFlow from "../components/marketing/SpecsDrivenFlow.astro";
import ArchitectFanOut from "../components/marketing/ArchitectFanOut.astro";
import NativeClientShowcase from "../components/marketing/NativeClientShowcase.astro";
import DownloadTracker from "../components/marketing/DownloadTracker.astro";

// Assets under public/ must carry the configured base path
// (ALFRED_OS_SITE_BASE) so a prefixed deploy still resolves them.
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}/${path.replace(/^\//, "")}`.replace(/\/{2,}/g, "/");

type JobState = "live" | "warn" | "idle" | "info";

const jobs: { title: string; body: string; log: string[]; state: JobState }[] = [
  {
    title: "Batman: architect for cross-repo features",
    body: "Reads the parent issue or Slack plan, checks the affected repos, gets approval, and files scoped repo-level work for the implementation roles.",
    log: [
      "[10:30] architect drafted bundle:billing-v2",
      "[10:31] architect posted plan to Slack",
      "[10:34] scope approved",
      "[10:35] architect opened backend -> web -> mobile tasks",
    ],
    state: "info",
  },
  {
    title: "Lucius: senior-dev opens PRs",
    body: "Picks up a scoped task, makes its own copy of the repo, runs Claude Code or Codex with the full project in context, and opens a pull request with tests.",
    log: [
      "[12:04] senior-dev claimed your-backend#247",
      "[12:04] senior-dev worktree ~/.alfred/wt/12042118/",
      "[12:18] senior-dev PR #1247 opened",
    ],
    state: "live",
  },
  {
    title: "Drake: planner shapes single-repo work",
    body: "Reads a Slack request, GitHub issue, or plain-text plan, asks for missing details, then files small tasks a coding agent can pick up on its own.",
    log: [
      "[09:02] drake refined settings plan",
      "[09:02] drake filed your-backend#248 agent:implement",
      "[09:03] drake linked acceptance checks",
    ],
    state: "live",
  },
  {
    title: "Ra's al Ghul: reviewer checks PRs",
    body: "Reads the changes, runs your test suite in its own copy of the repo, leaves comments on the lines that need work, and marks the pull request ready or needs changes.",
    log: [
      "[12:18] ras-al reviewed PR#1247",
      "[12:18] ras-al filed 2 inline nits",
      "[12:19] ras-al labelled needs-changes",
    ],
    state: "warn",
  },
  {
    title: "QA: Bane adds missing tests",
    body: "Looks at recently changed files, finds the places that need coverage, and opens focused test PRs that stand on their own.",
    log: [
      "[15:10] bane found low coverage in billing",
      "[15:23] bane PR #1250 opened",
      "[15:24] bane labelled tests-only",
    ],
    state: "live",
  },
  {
    title: "Fixer: Nightwing handles review comments",
    body: "Finds PRs opened by configured implementation roles with unresolved high-priority review comments, applies the fix in a clean worktree, and pushes the update back to the PR branch.",
    log: [
      "[16:01] nightwing found P1 on PR#1247",
      "[16:08] nightwing pushed fix",
      "[16:09] nightwing asked for re-review",
    ],
    state: "idle",
  },
];

const why = [
  {
    title: "Coordinates work between prompts",
    body: "Alfred claims the next approved task, assigns the configured role, isolates the run, routes review, records evidence, and reports when a decision is needed.",
  },
  {
    title: "Runs on a Mac or Linux box you choose",
    body: "Alfred runs on a Mac or Linux host you control and uses the Claude Code and Codex subscriptions you already have.",
  },
  {
    title: "Slack is optional",
    body: "You can plan and approve in Slack, the desktop app, or GitHub. Slack messages cannot bypass the configured approval or merge policy.",
  },
  {
    title: "Keeps reviewed local memory",
    body: "Alfred stores candidate lessons on your machine. Structural checks and a separate review decide what can affect later runs. Every memory action remains inspectable and reversible.",
  },
  {
    title: "Works on one repo or many at once",
    body: "Alfred can plan a single feature across several repos at the same time. It works the same way inside a monorepo, whether you use Turborepo, Nx, or Cargo workspaces.",
  },
  {
    title: "Open source, MIT licensed",
    body: "Every line is on GitHub at github.com/luminik-io/alfred. Fork it, read it, run it locally, or audit the code.",
  },
];

---

<MarketingLayout
  title="Alfred | Supervised coding-agent fleets on your machine"
  description="Alfred coordinates Claude Code and Codex through scheduled roles, isolated worktrees, independent review, local memory, and explicit approval gates."
  path="/"
>
  <Hero
    eyebrow="LOCAL AGENT OPERATIONS"
    headline="Run a supervised fleet of coding agents on your own machine."
    sub="Alfred coordinates Claude Code and Codex as short-lived engineering roles. It adds scheduling, separate worktrees, memory, independent review, and approval controls around the harnesses you already use."
    headlineSize="lg"
    headlineWrap="default"
    compactCtas
    primaryCta={{ label: "Download", href: "/download/", data: { "data-download-os": "other", "data-download-source": "home-hero", "data-download-kind": "intent" } }}
    secondaryCta={{ label: "Install", href: "/getting-started/install/" }}
    tertiaryCta={{ label: "GitHub", href: "https://github.com/luminik-io/alfred" }}
  />

  <section class="m-section m-section--soft" id="native-client">
    <div class="m-container">
      <SectionHeader
        eyebrow="THE DESKTOP APP"
        title="See and steer your agents from one desktop app."
        lede="Alfred Desktop is the recommended onboarding path. It detects an existing install, starts or connects to the local server, checks GitHub and engine auth, guides repo selection, and lets you choose a roster theme or custom display names. Slack is still where teams discuss and approve plans."
      />
      <NativeClientShowcase />
      <p style="margin-top:24px;">
        <a class="m-link" href="/concepts/native-client/">How the desktop app works</a>
      </p>
    </div>
  </section>

  <section class="m-section" id="tour">
    <div class="m-container">
      <SectionHeader
        eyebrow="PRODUCT TOUR"
        title="See the request, approval, work, and review surfaces."
        lede="Recorded from the repository's sample-data fixture. This tour shows Ask, Work, Code, Agents, and Settings. It contains no operator account or live repository data."
      />
      <div class="tour-video">
        <video controls playsinline preload="none" poster={withBase("media/alfred-tour-poster.png")}>
          <source src={withBase("media/alfred-tour.mp4")} type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="WHAT IT DOES FOR YOU"
        title="Specialist agents carry work from request to reviewed PR."
        lede="Each role has one job. The default install includes planning, architecture, implementation, review, test coverage, review fixes, cleanup, summaries, and policy-gated merge."
      />
      <div class="job-grid">
        {jobs.map((j, i) => (
          <div class={`m-reveal m-reveal-delay-${(i % 4) + 1}`}>
            <JobCard title={j.title} body={j.body} log={j.log} state={j.state} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="THE COORDINATION LAYER"
        title="Keep work moving between harness sessions."
        lede="Alfred claims selected work, creates an isolated worktree, invokes the configured harness, routes the result through review, and reports decisions through the configured control surface."
      />
      <div class="why-grid">
        {why.map((w, i) => (
          <article class={`m-card m-card--hover m-reveal m-reveal-delay-${(i % 3) + 1}`}>
            <h3 class="m-h3">{w.title}</h3>
            <p style="margin-top:10px;color:var(--alfred-text);font-size:15px;line-height:1.6;">{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="m-section m-section--soft" id="memory">
    <div class="m-container">
      <SectionHeader
        eyebrow="LOCAL MEMORY"
        title="Your agents keep a record of each run."
        lede="Alfred keeps reviewed lessons, file touches, failures, and current work on your machine. Structural checks and a separate model review control promotion. You can inspect, reject, retire, or revert each lesson."
      />
      <div class="memory-grid">
        <div class="memory-copy">
          <div class="memory-point">
            <span class="memory-point__kicker m-mono">01</span>
            <h3 class="m-h3">Promotion has explicit checks.</h3>
            <p>Agents and trusted teammates can propose a lesson. Alfred applies structural checks and a separate model review before the lesson can affect later runs.</p>
          </div>
          <div class="memory-point">
            <span class="memory-point__kicker m-mono">02</span>
            <h3 class="m-h3">Past problems are easy to find.</h3>
            <p>Setup blockers, timeouts, and repeated test failures all land in one place. The next time something breaks, your agents start from what happened before instead of digging back through old Slack messages.</p>
          </div>
          <div class="memory-point">
            <span class="memory-point__kicker m-mono">03</span>
            <h3 class="m-h3">The memory loop stays local.</h3>
            <p>Embedded SQLite provides the default recalled-lesson store. FleetBrain keeps the operational ledger and review state. Redis remains an optional scale battery.</p>
          </div>
          <p class="memory-link">
            <a class="m-link" href="/concepts/fleet-brain/">How local memory works</a>
          </p>
        </div>
        <CodeBlock
          title="fleet-brain"
          lines={[
            "$ alfred brain status",
            "ok    lessons              18",
            "ok    memory candidates    4",
            "ok    github items         37",
            "ok    bundle items         6",
            "ok    stale workers        0",
            "",
            "$ alfred brain promotions",
            "12    senior-dev  owner/api  evidence: PR#248",
            "19    architect   bundle     evidence: issue#504",
            "",
            "$ alfred brain failures --codename huntress",
            "timeout  playwright browser missing  3x",
            "",
            "slack> memory harvest",
            "preview  huntress local setup lesson",
            "slack> memory harvest now",
            "queued   candidate 21",
            "",
            "$ alfred brain redis-sync --dry-run",
            "would sync 18 reviewed lessons",
            "",
            "slack> memory",
            "slack> remember owner/api: keep retry copy testable",
            "slack> memory promote 12",
          ]}
        />
      </div>
      <div class="memory-bench">
        <div class="memory-bench__head">
          <span class="m-mono memory-bench__label">MEMORY A/B</span>
          <span class="memory-bench__note">Synthetic fixture, N=10 (+2 controls), single engine run</span>
        </div>
        <div class="memory-bench__stats">
          <div class="memory-bench__stat">
            <span class="memory-bench__num">80% <span class="memory-bench__to">to</span> 0%</span>
            <span class="memory-bench__cap">repeated-mistake rate over 10 convention tasks, memory off then on</span>
          </div>
          <div class="memory-bench__stat">
            <span class="memory-bench__num">8.3% <span class="memory-bench__to">to</span> 91.7%</span>
            <span class="memory-bench__cap">task success across all 12 tasks, memory off then on</span>
          </div>
          <div class="memory-bench__stat">
            <span class="memory-bench__num">240k vs 295k</span>
            <span class="memory-bench__cap">tokens in, memory on used fewer</span>
          </div>
        </div>
        <p class="memory-bench__body">
          The same suite of ten repo-convention tasks plus two controls ran twice
          through the <code>claude</code> CLI, changing only whether memory was on. It
          measures one thing: whether an agent repeats a mistake the fleet already
          learned about.
          <a class="m-link" href="https://github.com/luminik-io/alfred/blob/main/docs/BENCHMARKS.md#harder-fixture-result-engineclaude-n10">Method and repro</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="FROM ROUGH REQUEST TO SCOPED WORK"
        title="Batman handles the rollout. Lucius ships the PRs. Drake keeps smaller work scoped."
        lede="Start with a Slack thread, a GitHub issue, or a plain-text plan. Batman is the default-theme name for the public architect role: it handles approved multi-repo fan-out, Lucius handles repo-local implementation as senior-dev, and Drake turns smaller requests into clear tasks."
      />
      <SpecsDrivenFlow />
      <p style="margin-top:24px;">
        <a class="m-link" href="/guides/specs-driven-development/">How Alfred helps structure the plan</a>
      </p>
    </div>
  </section>

  <section class="m-section m-section--soft" id="architect">
    <div class="m-container">
      <SectionHeader
        eyebrow="THE ARCHITECT AGENT"
        title="Batman turns one large feature into repo-level work."
        lede="Batman is the default-theme name for the architect role. It reads the parent issue, checks the affected repos, plans the rollout, gets approval in Slack or the local client, and files scoped child issues. Senior-dev, test-engineer, fixer, reviewers, and the merge gate then finish each PR."
      />
      <ArchitectFanOut />
      <div class="architect-cta">
        <a class="m-btn" href="/multi-repo/">See planning across repos</a>
        <a class="m-btn m-btn--ghost" href="/guides/multi-repo-worked-example/">Read the worked example</a>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="HOW IT WORKS"
        title="One run, from start to finish."
        lede="From the moment a run starts to the pull request it opens. The same five stages happen every time an agent fires."
      />
      <FiringLifecycle />
      <p style="margin-top:32px;">
        <a class="m-link" href="/how-it-works/">See every step in a run</a>
      </p>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="YOUR AGENTS, RIGHT NOW"
        title="What `alfred status` shows."
        lede="The status view lists configured roles, schedules, recent outcomes, and health. The example below shows the full local roster."
      />
      <FleetStatus />
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="GET STARTED"
        title="Check the wiring before real work starts."
        lede="Run doctor for setup health, then dry-run one agent to see the path it would take without touching GitHub, Slack, an engine, or your files."
      />
      <CodeBlock
        title="terminal"
        lines={[
          "$ alfred doctor",
          "ok    gh auth                  luminik-io",
          "ok    claude code              authed",
          "ok    codex                    authed (optional)",
          "ok    launchd                  21 agents loaded",
          "ok    run limits               configured",
          "",
          "$ alfred dry-run senior-dev",
          "alfred dry-run: senior-dev",
          "  role: senior developer",
          "  mode: safe simulation",
          "  would: resolve config, acquire the agent lock, run preflight, and enter the runner",
          "  would not: mutate GitHub, post Slack, invoke an engine, or edit files",
        ]}
      />
    </div>
  </section>

  <DownloadTracker />
</MarketingLayout>

<style>
  .tour-video {
    margin-top: 28px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--alfred-border, rgba(255, 255, 255, 0.08));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    background: #07090f;
  }
  .tour-video video {
    display: block;
    width: 100%;
    height: auto;
  }
  .job-grid {
    display: grid;
    /* minmax(0, 1fr) overrides the default min-content min so cards
       cannot push the grid wider than the parent at 768px. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  /* Go single-column below 900px so the iPad-portrait (768) view
     stops looking like a half-baked desktop and the cards breathe.
     Keep minmax(0, 1fr) here too: bare 1fr is shorthand for
     minmax(auto, 1fr) which reintroduces min-content. */
  @media (max-width: 900px) { .job-grid { grid-template-columns: minmax(0, 1fr); } }
  /* The reveal wrapper is the actual grid item, so it (not JobCard) needs the
     min-width: 0 that lets the long <pre> log lines scroll inside the card
     instead of forcing min-content width and overflowing the page. */
  .job-grid > :global(.m-reveal) { min-width: 0; }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media (max-width: 720px) { .why-grid { grid-template-columns: 1fr; } }

  .memory-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 28px;
    align-items: start;
  }
  .memory-copy {
    display: grid;
    gap: 18px;
  }
  .memory-point {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 6px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--alfred-border);
  }
  .memory-point:last-of-type { border-bottom: none; }
  .memory-point__kicker {
    grid-row: span 2;
    color: var(--alfred-accent);
    letter-spacing: 0.16em;
    padding-top: 3px;
  }
  .memory-point p {
    margin: 0;
    color: var(--alfred-text);
    font-size: 15px;
    line-height: 1.6;
  }
  .memory-link { margin: 4px 0 0; }
  .memory-bench {
    margin-top: 28px;
    padding: 22px 24px;
    background: var(--alfred-bg-elevated);
    border: 1px solid var(--alfred-border-strong);
    border-radius: 12px;
  }
  .memory-bench__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--alfred-border);
  }
  .memory-bench__label {
    color: var(--alfred-accent);
    letter-spacing: 0.16em;
    font-size: 12px;
  }
  .memory-bench__note {
    color: var(--alfred-mute);
    font-size: 13px;
  }
  .memory-bench__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding: 20px 0 4px;
  }
  .memory-bench__stat {
    display: grid;
    gap: 6px;
  }
  .memory-bench__num {
    color: var(--alfred-text-bright);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .memory-bench__to {
    color: var(--alfred-accent);
    font-weight: 600;
    font-size: 15px;
    padding: 0 2px;
  }
  .memory-bench__cap {
    color: var(--alfred-text);
    font-size: 13px;
    line-height: 1.5;
  }
  .memory-bench__body {
    margin: 16px 0 0;
    color: var(--alfred-text);
    font-size: 14px;
    line-height: 1.65;
  }
  .memory-bench__body code {
    font-size: 0.92em;
  }
  @media (max-width: 720px) {
    .memory-bench__stats { grid-template-columns: 1fr; gap: 16px; }
  }
  @media (max-width: 880px) {
    .memory-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .memory-point {
      grid-template-columns: 1fr;
      row-gap: 8px;
    }
    .memory-point__kicker {
      grid-row: auto;
    }
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 980px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .steps { grid-template-columns: 1fr; } }

  .steps__item {
    background: var(--alfred-surface);
    border: 1px solid var(--alfred-border-strong);
    border-radius: 0;
    padding: 22px;
    position: relative;
  }
  .steps__label {
    color: var(--alfred-accent);
    letter-spacing: 0.18em;
    font-size: 12px;
    margin-bottom: 10px;
  }
  .steps__log {
    margin: 14px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--alfred-mute);
    background: var(--alfred-black);
    background: color-mix(in oklab, var(--alfred-black) 55%, transparent);
    border: 1px solid var(--glass-edge);
    border-radius: 0;
    padding: 10px 12px;
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .architect-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
</style>
