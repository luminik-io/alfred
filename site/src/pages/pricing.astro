---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/marketing/Hero.astro";
import SectionHeader from "../components/marketing/SectionHeader.astro";
import MetricRow from "../components/marketing/MetricRow.astro";
---

<MarketingLayout
  title="Pricing | Alfred is free, MIT"
  description="MIT license. No Alfred account or vendor fee. Bring an authenticated Claude Code, Codex, or OpenCode CLI."
  path="/pricing/"
>
  <Hero
    eyebrow="PRICING"
    headline="Alfred is free."
    sub="MIT license. No Alfred account or vendor fee. Bring an authenticated Claude Code, Codex, or OpenCode CLI."
    headlineSize="lg"
    primaryCta={{ label: "Install", href: "/getting-started/install/" }}
    secondaryCta={{ label: "GitHub", href: "https://github.com/luminik-io/alfred" }}
  >
    <div slot="panel" class="panel">
      <div class="panel__head">
        <span class="m-eyebrow">PRICING</span>
        <span class="m-mono m-mute">local runtime</span>
      </div>
      <MetricRow label="alfred license" value="$0 / MIT" state="live" />
      <MetricRow label="alfred vendor fee" value="$0" state="live" />
      <MetricRow label="claude code (yours)" value="from $20 / mo" glyph="arrow" state="info" />
      <MetricRow label="codex (optional)" value="from $20 / mo" glyph="arrow" state="info" />
      <MetricRow label="opencode (optional)" value="provider rate" glyph="arrow" state="info" />
      <MetricRow label="Alfred SaaS fee" value="$0" state="live" />
    </div>
  </Hero>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="WHAT YOU PAY"
        title="Your coding CLI and provider account."
        lede="Alfred invokes Claude Code, Codex, or OpenCode. Authentication, billing, and limits remain with the selected provider."
      />
      <div class="cards">
        <article class="m-card">
          <h3 class="m-h3">Claude Code subscription</h3>
          <p>Anthropic's CLI. Alfred shells out to claude -p with the scoped issue body. Bring your own plan; Pro and Max both work.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Codex CLI (optional)</h3>
          <p>OpenAI's coding CLI. Use it for hybrid routing: Claude for plans, Codex for implementation, or split builders and reviewers.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">OpenCode (optional)</h3>
          <p>Select any provider account stored by OpenCode. Alfred records OpenCode's reported usage and cost for each firing.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="WHAT YOU DO NOT PAY"
        title="No vendor account."
        lede="Alfred adds none of these charges."
      />
      <div class="cards">
        <article class="m-card">
          <h3 class="m-h3">No Alfred model bill</h3>
          <p>Alfred does not proxy model traffic. Model charges, if any, come from the provider account selected in your coding CLI.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">No Alfred SaaS fee</h3>
          <p>There is no Alfred dashboard you log into. There is no usage tier, no seat count, no contract.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Runs locally on macOS or Linux</h3>
          <p>You choose the host. Alfred keeps its worktrees and runtime state under <code>ALFRED_HOME</code>.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="HOST REQUIREMENTS"
        title="A supported Mac or Linux host you control."
        lede="The host runs the scheduler, authenticated coding CLIs, project tools, and local Alfred state. Size it for the repositories and builds you plan to run."
      />
      <div class="cards">
        <article class="m-card">
          <h3 class="m-h3">A Mac or Linux box</h3>
          <p>macOS uses launchd. Linux uses systemd --user. Either way, the host has to stay awake during the cron windows you set.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Slack (optional)</h3>
          <p>Use an incoming webhook for reports, or add the bot and Socket Mode permissions required by the planning features you enable.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">AWS for secrets (optional)</h3>
          <p>If you want IAM-scoped secrets, Alfred reads from AWS Secrets Manager. If you don't, plain .env on disk works.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container" style="text-align:center;">
      <a class="m-btn" href="/install/" style="font-size:16px;padding:16px 28px;">Install Alfred</a>
    </div>
  </section>
</MarketingLayout>

<style>
  .panel { display: flex; flex-direction: column; }
  .panel__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; margin-bottom: 6px; border-bottom: 1px solid var(--alfred-border); }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 980px) { .cards { grid-template-columns: 1fr; } }
  .cards p { margin-top: 10px; color: var(--alfred-text); font-size: 15px; line-height: 1.6; }
</style>
