---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/marketing/Hero.astro";
import SectionHeader from "../components/marketing/SectionHeader.astro";
---

<MarketingLayout
  title="Alfred for solo builders and small engineering teams"
  description="Coordinate Claude Code, Codex, or OpenCode through local schedules, repository scope, worktrees, review, and explicit approval."
  path="/for-solo-founders/"
>
  <Hero
    eyebrow="FOR SOLO BUILDERS AND SMALL TEAMS"
    headline="Keep several coding-agent tasks moving through one controlled workflow."
    sub="Alfred schedules approved work on a Mac or Linux host, routes it through Claude Code, Codex, or OpenCode, and returns pull requests and review findings for your decision."
    headlineSize="lg"
    primaryCta={{ label: "Install", href: "/getting-started/install/" }}
    secondaryCta={{ label: "GitHub", href: "https://github.com/luminik-io/alfred" }}
  />

  <section class="m-section">
    <div class="m-container">
      <SectionHeader
        eyebrow="OPERATING MODEL"
        title="Separate the recurring engineering loop from the decisions only you can make."
        lede="Alfred coordinates task intake, isolated code changes, independent review, evidence, and follow-up. You choose repositories, schedules, engines, approval rules, and merge policy."
      />
      <div class="grid">
        <article class="m-card">
          <h3 class="m-h3">Queue approved work</h3>
          <p>Start from a GitHub issue, Desktop request, Slack plan, or structured specification. Planned work waits at the configured approval gate.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Separate code changes</h3>
          <p>Implementation, test, review, and fix roles use dedicated git worktrees. Alfred records the branch, checks, and pull-request evidence.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Choose an engine for each role</h3>
          <p>Assign Claude Code, Codex, or OpenCode per role. The hybrid route remains Claude Code first with Codex fallback.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Keep reviewed lessons</h3>
          <p>Embedded SQLite recalls promoted lessons. Behavior-changing candidates wait for review by default, and memory actions remain reversible.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="m-section m-section--soft">
    <div class="m-container">
      <SectionHeader
        eyebrow="CONTROL POINTS"
        title="Alfred stops when the next step needs your authority."
        lede="The product controls scheduling and workflow. It does not replace repository policy, operating-system isolation, or human judgment."
      />
      <div class="grid">
        <article class="m-card">
          <h3 class="m-h3">Repository scope</h3>
          <p>Alfred schedules and indexes configured repositories. Use a dedicated user, virtual machine, or container when you need filesystem or network isolation.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Approval</h3>
          <p>Planned work and multi-repository fan-out can wait for explicit approval before entering the autonomous queue.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Review</h3>
          <p>A separate role reviews code and records findings. Missing GitHub evidence remains unavailable instead of appearing as zero.</p>
        </article>
        <article class="m-card">
          <h3 class="m-h3">Merge</h3>
          <p>Alfred does not merge by default. If you enable a merge policy, GitHub checks, reviews, threads, and repository rules remain the final gate.</p>
        </article>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .grid p {
    margin-top: 10px;
    color: var(--alfred-text);
    font-size: 15px;
    line-height: 1.6;
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
