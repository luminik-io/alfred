---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/marketing/Hero.astro";
import ImpactCounter from "../components/marketing/ImpactCounter.astro";
import ImpactProofBoard from "../components/marketing/ImpactProofBoard.astro";
import ImpactTrend from "../components/marketing/ImpactTrend.astro";
import proof from "../data/impact-proof.json";

const linesChanged = proof.summary.lines_added + proof.summary.lines_removed;
const publicTrend = Array.isArray((proof as { trend?: unknown }).trend)
  ? (proof as { trend: Array<{ week: string; prs_merged: number }> }).trend
  : [];
const defaultTelemetryStatsUrl = "https://alfred-proof-telemetry.luminik.workers.dev/stats";
const telemetryStatsUrl = (
  import.meta.env.PUBLIC_ALFRED_TELEMETRY_STATS_URL ?? defaultTelemetryStatsUrl
).trim();
const hasLiveTelemetry = telemetryStatsUrl.length > 0;
const hasPublicActivity =
  proof.prs.length > 0 ||
  proof.issues.length > 0 ||
  proof.summary.prs_merged > 0 ||
  proof.summary.issues_opened > 0 ||
  proof.summary.issues_triaged > 0 ||
  Number(proof.summary.repo_activity?.prs_merged ?? 0) > 0 ||
  Number(proof.summary.repo_activity?.issues_opened ?? 0) > 0 ||
  Number(proof.summary.repo_activity?.files_changed ?? 0) > 0;
---

<MarketingLayout
  title="Impact | Alfred"
  description="Public GitHub evidence from the Alfred repository, plus optional anonymous aggregate telemetry from participating installations."
  path="/impact/"
>
  <Hero
    eyebrow="PUBLIC EVIDENCE"
    headline="Check Alfred against its own repository."
    sub="The repository proof uses exact provenance labels. It excludes Dependabot and branch-name-only matches, and links each counted pull request."
    headlineSize="lg"
    primaryCta={{ label: "Download", href: "/download/" }}
    secondaryCta={{ label: "Telemetry details", href: "/reference/telemetry/" }}
  >
    <div slot="panel" class="impact-panel">
      <div class="impact-panel__head">
        <span class="impact-panel__window">Last {proof.window.days} days</span>
        <span class="m-mono m-mute">public GitHub data</span>
      </div>
      <ImpactCounter
        variant="plain"
        seed={{
          prs_merged: proof.summary.prs_merged,
          issues_opened: proof.summary.issues_opened,
          issues_closed: proof.summary.issues_closed,
          lines_added: proof.summary.lines_added,
          lines_removed: proof.summary.lines_removed,
          lines_changed: linesChanged,
          files_changed: proof.summary.files_changed,
          updated_at: proof.generated_at,
        }}
        live={false}
        liveWindow="last_30_days"
        showUpdated={false}
        showInstalls={false}
      />
    </div>
  </Hero>

  {publicTrend.length > 0 ? (
    <section class="m-section impact-section">
      <div class="m-container">
        <ImpactTrend trend={publicTrend} windowDays={proof.window.days} />
      </div>
    </section>
  ) : null}

  {hasLiveTelemetry ? (
    <section class="m-section impact-section">
      <div class="m-container impact-live-section">
        <div class="impact-live-section__copy">
          <span class="m-eyebrow">LIVE TOTALS</span>
          <h2 class="m-display-md">Anonymous aggregate telemetry.</h2>
          <p>
            Participating installations report counts only. The payload excludes
            code, prompts, repository names, branches, paths, and hostnames. You
            can disable it with <code>alfred telemetry off</code>.
          </p>
        </div>
        <ImpactCounter threshold={1} />
      </div>
    </section>
  ) : null}

  {hasPublicActivity ? (
    <section class="m-section">
      <div class="m-container">
        <ImpactProofBoard proof={proof} />
      </div>
    </section>
  ) : null}
</MarketingLayout>

<style>
  .impact-panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .impact-panel__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--alfred-border);
  }
  .impact-panel__window {
    color: var(--alfred-text-bright);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
  }
  .impact-section {
    padding-top: 72px;
  }
  .impact-live-section {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(340px, 1fr);
    gap: 28px;
    align-items: start;
  }
  .impact-live-section__copy {
    padding-top: 12px;
  }
  .impact-live-section__copy h2 {
    margin-top: 12px;
  }
  .impact-live-section__copy p {
    max-width: 460px;
    color: var(--alfred-text);
    font-size: 16px;
    line-height: 1.65;
  }
  @media (max-width: 820px) {
    .impact-live-section {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .impact-panel__head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
